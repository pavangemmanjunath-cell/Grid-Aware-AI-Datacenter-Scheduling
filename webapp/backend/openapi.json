 "components": {
  "schemas": {
   "AssistantQuestion": {
    "properties": {
     "question": {
      "type": "string",
      "maxLength": 2000,
      "minLength": 3,
      "title": "Question"
     }
    },
    "type": "object",
    "required": [
     "question"
    ],
    "title": "AssistantQuestion"
   },
   "AssistantStatus": {
    "properties": {
     "enabled": {
      "type": "boolean",
      "title": "Enabled"
     },
     "provider": {
      "type": "string",
      "title": "Provider"
     },
     "message": {
      "type": "string",
      "title": "Message"
     }
    },
    "type": "object",
    "required": [
     "enabled",
     "provider",
     "message"
    ],
    "title": "AssistantStatus"
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "type": "array",
      "title": "Detail"
     }
    },
    "type": "object",
    "title": "HTTPValidationError"
   },
   "Health": {
    "properties": {
     "status": {
      "type": "string",
      "const": "ok",
      "title": "Status"
     },
     "version": {
      "type": "string",
      "title": "Version"
     },
     "benchmark_hours": {
      "type": "integer",
      "title": "Benchmark Hours"
     }
    },
    "type": "object",
    "required": [
     "status",
     "version",
     "benchmark_hours"
    ],
    "title": "Health"
   },
   "HourlySeries": {
    "properties": {
     "grid_import_MW": {
      "items": {
       "type": "number"
      },
      "type": "array",
      "title": "Grid Import Mw"
     },
     "electrolyser_MW": {
      "items": {
       "type": "number"
      },
      "type": "array",
      "title": "Electrolyser Mw"
     },
     "fuel_cell_MW": {
      "items": {
       "type": "number"
      },
      "type": "array",
      "title": "Fuel Cell Mw"
     },
     "curtailed_MW": {
      "items": {
       "type": "number"
      },
      "type": "array",
      "title": "Curtailed Mw"
     },
     "h2_inventory_MWh": {
      "items": {
       "type": "number"
      },
      "type": "array",
      "title": "H2 Inventory Mwh"
     },
     "flexible_load_MW": {
      "items": {
       "type": "number"
      },
      "type": "array",
      "title": "Flexible Load Mw"
     },
     "connection_cap_MW": {
      "items": {
       "anyOf": [
        {
         "type": "number"
        },
        {
         "type": "null"
        }
       ]
      },
      "type": "array",
      "title": "Connection Cap Mw"
     }
    },
    "type": "object",
    "required": [
     "grid_import_MW",
     "electrolyser_MW",
     "fuel_cell_MW",
     "curtailed_MW",
     "h2_inventory_MWh",
     "flexible_load_MW",
     "connection_cap_MW"
    ],
    "title": "HourlySeries"
   },
   "Job": {
    "properties": {
     "id": {
      "type": "string",
      "title": "Id"
     },
     "status": {
      "$ref": "#/components/schemas/JobStatus"
     },
     "progress": {
      "type": "number",
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Progress"
     },
     "request": {
      "$ref": "#/components/schemas/WhatIfRequest"
     },
     "created_utc": {
      "type": "string",
      "title": "Created Utc"
     },
     "finished_utc": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Finished Utc"
     },
     "runtime_s": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "title": "Runtime S"
     },
     "result": {
      "anyOf": [
       {
        "$ref": "#/components/schemas/WhatIfResult"
       },
       {
        "type": "null"
       }
      ]
     },
     "error": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Error"
     }
    },
    "type": "object",
    "required": [
     "id",
     "status",
     "progress",
     "request",
     "created_utc"
    ],
    "title": "Job"
   },
   "JobStatus": {
    "type": "string",
    "enum": [
     "queued",
     "running",
     "succeeded",
     "failed"
    ],
    "title": "JobStatus"
   },
   "Metrics": {
    "properties": {
     "grid_energy_MWh": {
      "type": "number",
      "title": "Grid Energy Mwh"
     },
     "peak_import_MW": {
      "type": "number",
      "title": "Peak Import Mw"
     },
     "operational_CO2_t": {
      "type": "number",
      "title": "Operational Co2 T"
     },
     "renewable_utilization_pct": {
      "type": "number",
      "title": "Renewable Utilization Pct"
     },
     "curtailed_MWh": {
      "type": "number",
      "title": "Curtailed Mwh"
     },
     "electrolyser_MWh": {
      "type": "number",
      "title": "Electrolyser Mwh"
     },
     "fuel_cell_MWh": {
      "type": "number",
      "title": "Fuel Cell Mwh"
     },
     "average_workload_delay_h": {
      "type": "number",
      "title": "Average Workload Delay H"
     },
     "max_workload_delay_h": {
      "type": "integer",
      "title": "Max Workload Delay H"
     },
     "jobs_shifted_pct": {
      "type": "number",
      "title": "Jobs Shifted Pct"
     },
     "violation_energy_MWh": {
      "type": "number",
      "title": "Violation Energy Mwh"
     },
     "h2_terminal_MWh": {
      "type": "number",
      "title": "H2 Terminal Mwh"
     }
    },
    "type": "object",
    "required": [
     "grid_energy_MWh",
     "peak_import_MW",
     "operational_CO2_t",
     "renewable_utilization_pct",
     "curtailed_MWh",
     "electrolyser_MWh",
     "fuel_cell_MWh",
     "average_workload_delay_h",
     "max_workload_delay_h",
     "jobs_shifted_pct",
     "violation_energy_MWh",
     "h2_terminal_MWh"
    ],
    "title": "Metrics"
   },
   "PublicDataset": {
    "properties": {
     "name": {
      "type": "string",
      "title": "Name"
     },
