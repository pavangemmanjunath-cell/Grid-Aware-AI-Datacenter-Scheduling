      },
      "description": "R0-R5"
     },
     {
      "name": "hour",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string",
       "description": "integer 0-167",
       "default": "0",
       "title": "Hour"
      },
      "description": "integer 0-167"
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
